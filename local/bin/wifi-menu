#!/usr/bin/env bash
# waybar 网络图标 → GTK4 + libnm 的 Wi-Fi 菜单
# 常驻模式：首次点击启动（约 1s），之后每次点击只是 SIGUSR1 唤起（几十毫秒）
LOCK="${XDG_RUNTIME_DIR:-/tmp}/wifi-menu.pid"
case "$*" in
  *--demo*) exec /usr/bin/python3 $HOME/.local/share/wifi-menu/wifi-menu.py "$@" ;;
esac
if [ -r "$LOCK" ]; then
  pid=$(cat "$LOCK" 2>/dev/null)
  if [ -n "$pid" ] && [ "$pid" -gt 1 ] && kill -0 "$pid" 2>/dev/null; then
    kill -USR1 "$pid" 2>/dev/null
    exit 0
  fi
  rm -f "$LOCK"   # 陈旧锁
fi
exec /usr/bin/python3 $HOME/.local/share/wifi-menu/wifi-menu.py --serve --show "$@"
